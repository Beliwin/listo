# Listo configuration — copy to `.env` and adjust.
# Values shown are defaults unless marked REQUIRED.

# REQUIRED — random secret (>= 16 chars) signing session cookies.
# Generate one:  openssl rand -hex 32
# Rotating it logs every device out.
SESSION_SECRET=

# ── First admin account (bootstrap only) ─────────────────────────────────────
# On a brand-new instance (empty database) the first admin account is created
# from these. Once any account exists they are IGNORED — manage users in-app
# (admins mint single-use invite links from Settings → Manage accounts).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Or read the password from a file (Docker/K8s secret):
# ADMIN_PASSWORD_FILE=/run/secrets/listo_admin_password

# ── Network ──────────────────────────────────────────────────────────────────
PORT=8787
HOST=0.0.0.0

# ── Storage ──────────────────────────────────────────────────────────────────
# The SQLite database and its -wal/-shm sidecars live here. Mount a volume on it.
DATA_DIR=/data

# ── Reverse proxy / cookies ──────────────────────────────────────────────────
# Set true when running behind a TLS-terminating reverse proxy (e.g. Nginx Proxy
# Manager). Enables Secure cookies. NEVER expose Listo over plain HTTP on the
# internet — always put it behind a proxy with TLS.
TRUST_PROXY=false
# Defaults to TRUST_PROXY; override only if you understand the implication.
# COOKIE_SECURE=false

# ── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# ── Sync tuning (advanced — leave default unless you know why) ────────────────
# MAX_DRIFT_MS=60000
# TOMBSTONE_RETENTION_DAYS=90
